# Copy to .env and fill in (`.env` is git-ignored, never commit real tokens).
# The compose file reads every variable from here; all defaults are public
# (browser.ceki.me / api.ceki.me) — point the endpoints at your stand here.

# ── providers / tokens ──────────────────────────────────────────────────────
# One-time browser tokens from the dashboard — one PER schedule/provider.
# Each daemon needs its own distinct token and schedule id.
CEKI_PROVIDER_TOKEN_CHROMIUM=
CEKI_PROVIDER_SCHEDULE_ID_CHROMIUM=
CEKI_PROVIDER_TOKEN_PSEUDO=
CEKI_PROVIDER_SCHEDULE_ID_PSEUDO=

# ── endpoints (public defaults; override for dev/internal stands) ──────────
CEKI_WS_URL=wss://browser.ceki.me/ws/provider
CEKI_API_URL=https://api.ceki.me

# ── outbound proxy (optional; empty = direct) ────────────────────────────────
# e.g. CEKI_PROXY_URL=http://user:pass@1.2.3.4:3128
CEKI_PROXY_URL=
CEKI_PROXY_BYPASS_EXTRA=

# ── per-flavor slot allocation (must not overlap on the same host) ─────────
# chromium occupies :98 base display, rent CDP 9200+, rent X 121+
CEKI_DAEMON_CDP_START_CHROMIUM=9200
CEKI_DAEMON_DISPLAY_START_CHROMIUM=121
DISPLAY_CHROMIUM=:98
# pseudo-yandex occupies :99 base display, rent CDP 9223+, rent X 101+
CEKI_DAEMON_CDP_START_PSEUDO=9223
CEKI_DAEMON_DISPLAY_START_PSEUDO=101
DISPLAY_PSEUDO=:99

# ── misc ────────────────────────────────────────────────────────────────────
CEKI_PROVIDER_LOG_LEVEL=INFO
TZ=
CEKI_EXT_SKIP_UPDATE=1