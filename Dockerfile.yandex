# syntax=docker/dockerfile:1
#
# Ceki headless-browser provider image — YANDEX flavor (real Yandex Browser).
#
# Same provider launcher and extension as Dockerfile (chromium), but the rented
# browser is the CORPORATE build of Yandex Browser (repo.yandex.ru deb). Its UA
# carries YaBrowser/<ver>, which Yandex services trust harder than a spoofed
# string, and the build ships the Russian Trusted CA natively.
#
# Why corporate and not stable: only the corporate build honors extension
# policies. stable/beta strip the --load-extension switch outright and gate
# every other install path behind their own experiment system (the deb's own
# Extensions/*.json carries "experiment":"cdt2"; without it the file is
# skipped, and the same goes for external_update_url files and
# ExtensionSettings). The corporate build reads the managed-policy root
# normally — verified live: ExtensionInstallForcelist installs the extension
# from the update channel and its MV3 service worker starts.
#
# The entrypoint writes ExtensionInstallForcelist + YandexProtectedMode:false
# into /etc/opt/yandex/browser/policies/managed/ceki.json when
# CEKI_PROVIDER_BROWSER=yandex. Protected mode must be off: it turns itself on
# for online-banking/payment pages and disables every extension except
# Yandex-approved password managers — chrome.debugger.attach then fails with
# "Access denied." and the rental dies about a second after it starts.
#
# Build context = repo root. `build.sh` stages the extension dist into
# extension/ (git-ignored) before `docker build`.
#
# Sibling images: Dockerfile (chromium, default),
# Dockerfile.pseudo-yandex (Chromium with a YaBrowser UA).

FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    DISPLAY=:99 \
    PYTHONPATH=/opt/ceki/src

WORKDIR /opt/ceki

LABEL org.opencontainers.image.source=https://github.com/Ceki-me/docker-browser \
      org.opencontainers.image.title=ceki-browser-provider-yandex \
      org.opencontainers.image.description="Ceki headless-browser provider image: Yandex Browser (corporate) + browser extension + provider launcher"

# Yandex Browser runtime libraries (superset of Chromium's) + Xvfb virtual
# display + libnss3-tools (certutil for the NSS trust DB — see the CA block).
RUN apt-get update && apt-get install -y --no-install-recommends \
        libnss3 libnspr4 libnss3-tools libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 \
        libxkbcommon0 libatspi2.0-0 libxcomposite1 libxdamage1 libxfixes3 \
        libxrandr2 libgbm1 libpango-1.0-0 libcairo2 libasound2 libxshmfence1 \
        libglib2.0-0 libgdk-pixbuf-2.0-0 xvfb xauth x11-utils ca-certificates curl \
        wget gnupg \
    && rm -rf /var/lib/apt/lists/*

# Russian Trusted Root CA / Sub CA (Минцифры, НУЦ) — see Dockerfile for the
# full rationale and the pinning scheme. Yandex Browser ships this root in its
# own build; it is installed here anyway so curl/python inside the container
# trust the same sites, and so the trust story does not depend on which binary
# launches. Fetched at build time from gu-st.ru, pinned by sha256 (DER).
ARG RU_ROOT_CA_SHA256=d26d2d0231b7c39f92cc738512ba54103519e4405d68b5bd703e9788ca8ecf31
ARG RU_SUB_CA_SHA256=bbbde2103e790b999ec62bd03cf625a5a2e7c316e10afe6a490eedead8b3fd9b
RUN set -eu; \
    fetch_pin() { \
        url="$1"; pin="$2"; out="$3"; \
        curl -fsSL --retry 3 --connect-timeout 15 "$url" -o "$out"; \
        got="$(openssl x509 -in "$out" -outform DER 2>/dev/null | sha256sum | cut -d' ' -f1)"; \
        if [ "$got" != "$pin" ]; then \
            echo "FATAL: $url sha256 mismatch: expected $pin, got $got" >&2; \
            exit 1; \
        fi; \
    }; \
    fetch_pin "https://gu-st.ru/content/lending/russian_trusted_root_ca_pem.crt" \
        "$RU_ROOT_CA_SHA256" /usr/local/share/ca-certificates/russian_trusted_root_ca.crt; \
    fetch_pin "https://gu-st.ru/content/lending/russian_trusted_sub_ca_pem.crt" \
        "$RU_SUB_CA_SHA256" /usr/local/share/ca-certificates/russian_trusted_sub_ca.crt
RUN update-ca-certificates \
    && for db in /etc/pki/nssdb /root/.pki/nssdb; do \
        mkdir -p "$db" \
        && certutil -N -d "sql:$db" --empty-password \
        && certutil -A -d "sql:$db" -t "C,," -n "Russian Trusted Root CA" \
            -i /usr/local/share/ca-certificates/russian_trusted_root_ca.crt \
        && certutil -A -d "sql:$db" -t "C,," -n "Russian Trusted Sub CA" \
            -i /usr/local/share/ca-certificates/russian_trusted_sub_ca.crt; \
    done

# Python deps: the SDK (API client + config) and Playwright (Chromium driver).
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Provider launcher module (this repo).
COPY src/ /opt/ceki/src/

# Yandex Browser: the CORPORATE deb from the official repo. The repo only
# serves the latest build, and newer Yandex versions (26.8+) have broken the
# Ceki extension (extension never connects → rent stuck). The only known-good
# version is the corporate 26.6.x (verified 2026-09-18 on ceki/provider:yandex-daemon-c266).
# apt cannot pin an older version (repo doesn't keep them), so we HARD-FAIL the
# build if the install resolves to anything but 26.6.* — never silently ship a
# broken newer browser.
RUN wget -qO- https://repo.yandex.ru/yandex-browser/YANDEX-BROWSER-KEY.GPG \
        | gpg --dearmor -o /usr/share/keyrings/yandex-browser.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/yandex-browser.gpg] https://repo.yandex.ru/yandex-browser/deb stable main" \
        > /etc/apt/sources.list.d/yandex-browser.list \
    && apt-get update && apt-get install -y --no-install-recommends yandex-browser-corporate \
    && VER="$(yandex-browser --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+' | head -1)" \
    && echo "yandex-browser-corporate resolved to: $(yandex-browser --version 2>/dev/null)" \
    && case "$VER" in 26.6) echo "OK: yandex 26.6 (known-good corporate build)";; *) echo "FATAL: yandex $VER != 26.6 — corporate 26.6 is the only build the extension supports. Do NOT ship this image."; exit 1;; esac \
    && rm -rf /var/lib/apt/lists/*

# Playwright's Chromium stays installed as a fallback binary (app.py falls back
# with a warning if the Yandex binary is missing) and for the pseudo-yandex
# style UA tooling.
RUN python -m playwright install chromium

# This image rents out the real Yandex Browser (settable at runtime; the
# chromium image is the one to use for CEKI_PROVIDER_BROWSER=chromium).
ENV CEKI_PROVIDER_BROWSER=yandex

# Bundled browser extension dist (staged into extension/ by build.sh).
COPY extension/ /opt/ceki/extension/

# CEKI_PROVIDER_TOKEN is supplied at runtime (docker run -e ...).
ENV CEKI_PROVIDER_EXT_DIR=/opt/ceki/extension \
    CEKI_PROVIDER_LOG_LEVEL=INFO

# Entrypoint starts Xvfb (if needed) and then execs the command as PID 1 so a
# `docker stop` (SIGTERM to PID 1) reaches the provider for a clean shutdown.
COPY entrypoint.sh /usr/local/bin/ceki-entrypoint
RUN chmod +x /usr/local/bin/ceki-entrypoint

ENTRYPOINT ["/usr/local/bin/ceki-entrypoint"]
CMD ["python", "-m", "ceki_browser_provider.app"]
