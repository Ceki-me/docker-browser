# syntax=docker/dockerfile:1
#
# Dev overlay for yandex provider: refresh daemon.py + extension dist on top
# of the prod yandex image (Yandex 26.6.4.838). Dev-only, NOT committed.
FROM ceki/provider:yandex-daemon-prod

WORKDIR /opt/ceki

# Refresh provider sources (daemon.py landed after prod image was built).
COPY src/ /opt/ceki/src/

# Refresh entrypoint (mkdir /tmp/ceki-dl — download temp dir fix).
COPY entrypoint.sh /usr/local/bin/ceki-entrypoint

# Refresh extension dist (restaged to 0.6.335 dev before build).
COPY extension/ /opt/ceki/extension/

# Sanity: entrypoint + python import ok + extension version.
RUN chmod +x /usr/local/bin/ceki-entrypoint \
 && python -m compileall -q /opt/ceki/src/ceki_browser_provider \
 && python -c "import ceki_browser_provider.daemon; print('daemon import OK')" \
 && grep -q '"version": "0.6.335"' /opt/ceki/extension/manifest.json && echo 'extension 0.6.335 OK'

LABEL ceki.local=dev-yandex-overlay